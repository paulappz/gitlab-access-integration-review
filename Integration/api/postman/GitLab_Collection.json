{
  "info": {
    "name": "GitLab Access Audit",
    "description": "API requests to audit third-party access in GitLab. Docs: https://docs.gitlab.com/ee/api/",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "GITLAB_URL",
      "value": "http://your-gitlab-instance.com",
      "description": "Your GitLab instance URL (e.g., https://gitlab.com)"
    },
    {
      "key": "PRIVATE_TOKEN",
      "value": "your_access_token",
      "description": "GitLab Personal Access Token with `read_api` and `read_user` scopes."
    },
    {
      "key": "PROJECT_ID",
      "value": "2",
      "description": "ID of the project to audit (find it in Project Settings → General)."
    },
    {
      "key": "GROUP_ID",
      "value": "4",
      "description": "ID of the group to audit (find it in Group Settings → General)."
    }
  ],
  "item": [
    {
      "name": "Get External Users (SAML/OAuth)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "PRIVATE-TOKEN",
            "value": "{{PRIVATE_TOKEN}}"
          }
        ],
        "url": "{{GITLAB_URL}}/api/v4/users?with_identities=true",
        "description": "Docs: https://docs.gitlab.com/ee/api/users.html#list-users"
      }
    },
    {
      "name": "List Project Access Tokens",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "PRIVATE-TOKEN",
            "value": "{{PRIVATE_TOKEN}}"
          }
        ],
        "url": "{{GITLAB_URL}}/api/v4/projects/{{PROJECT_ID}}/access_tokens",
        "description": "Docs: https://docs.gitlab.com/ee/api/project_access_tokens.html"
      }
    },
    {
      "name": "List CI/CD Pipelines",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "PRIVATE-TOKEN",
            "value": "{{PRIVATE_TOKEN}}"
          }
        ],
        "url": "{{GITLAB_URL}}/api/v4/projects/{{PROJECT_ID}}/pipelines",
        "description": "Docs: https://docs.gitlab.com/ee/api/pipelines.html"
      }
    },
    {
      "name": "List Project Webhooks",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "PRIVATE-TOKEN",
            "value": "{{PRIVATE_TOKEN}}"
          }
        ],
        "url": "{{GITLAB_URL}}/api/v4/projects/{{PROJECT_ID}}/hooks",
        "description": "Docs: https://docs.gitlab.com/ee/api/projects.html#list-project-hooks"
      }
    },
    {
      "name": "Retrieve Audit Logs (Premium Only)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "PRIVATE-TOKEN",
            "value": "{{PRIVATE_TOKEN}}"
          }
        ],
        "url": "{{GITLAB_URL}}/api/v4/audit_events",
        "description": "Requires GitLab Premium. Docs: https://docs.gitlab.com/ee/api/audit_events.html"
      }
    },
    {
      "name": "Check Tokens Nearing Expiry (Advanced Filters)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "PRIVATE-TOKEN",
            "value": "{{PRIVATE_TOKEN}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{GITLAB_URL}}/api/v4/projects/{{project_id}}/access_tokens",
          "host": [
            "{{GITLAB_URL}}"
          ],
          "path": [
            "api",
            "v4",
            "projects",
            "{{project_id}}",
            "access_tokens"
          ],
          "query": [
            {
              "key": "token_name",
              "value": "example-token",
              "description": "Filter tokens by name substring"
            },
            {
              "key": "created_before",
              "value": "2025-01-01",
              "description": "Filter tokens created before this date"
            },
            {
              "key": "created_after",
              "value": "2024-01-01",
              "description": "Filter tokens created after this date"
            }
          ]
        },
        "description": "Get project access tokens nearing expiry with optional filters (name, creation date)."
      },
      "response": []
    }
  ],
  "event": [
    {
      "listen": "test",
      "script": {
        "exec": [
          "pm.test('Status code is 200', function () {",
          "    pm.response.to.have.status(200);",
          "});"
        ],
        "type": "text/javascript"
      }
    }
  ]
}